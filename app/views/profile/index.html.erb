<%= react_component(
  "Profile",
  props: {
    user: @user.as_json(),
    friends: @friends,
    notifications: @notifications.as_json(),
    requesters: @requesters,
    totalmatches: @totalmatches,
    world_cups: @world_cups,
    badges: @badges.map { |badge|
      badge.as_json.merge(
            image: badge.image.attached? ? url_for(badge.image): nil
      )
    },    
    Favicon: "/assets/LogoO2.png",
    RetoLogo: "/assets/RetoLogo2.png"
  },
  options: {
    prerender: false
  }
) %>